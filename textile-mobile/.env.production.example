# Noxis Mobile Production Environment Template
# Save as .env.production

# Industrial Connectivity
EXPO_PUBLIC_HUB_DEFAULT_PORT=9000
EXPO_PUBLIC_PORTAL_URL=https://noxis.app/portal

# Monitoring
SENTRY_DSN=your_mobile_sentry_dsn

# IMPORTANT: NEVER prefix secrets with EXPO_PUBLIC_
# These are managed via EAS Secrets or secure runtime injection
