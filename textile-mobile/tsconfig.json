{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/src/*": ["src/*"]
    }
  },
  "exclude": [
    "supabase/functions",
    "src/lib/mesh/NoxisSynapse",
    "node_modules",
    "android",
    "ios",
    ".expo",
    "dist"
  ]
}
