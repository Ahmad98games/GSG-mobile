{
  "expo": {
    "name": "Noxis",
    "slug": "noxis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omnoralabs.noxis",
      "jsEngine": "hermes"
    },
    "android": {
      "package": "com.omnoralabs.noxis",
      "jsEngine": "hermes",
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121417"
      }
    },
    "extra": {
      "eas": {
        "projectId": "55621019-2846-48a0-8bba-8fce5d8bb483"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Noxis to scan industrial QR codes"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Noxis to record tactical voice notes"
        }
      ],
      "expo-sqlite"
    ]
  }
}
